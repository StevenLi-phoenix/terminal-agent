    "shell-quote": "^1.8.1",
    "ws": "^8.18.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^3.0.1",
    "@types/shell-quote": "^1.7.5",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
